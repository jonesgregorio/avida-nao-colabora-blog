@@ -52,4 +52,60 @@ test('automações editoriais sem executor não podem voltar como ativas', () =>
-  assert.match(edge, /generate_daily/)
-  assert.match(edge, /generate_weekly_package/)
-  assert.match(edge, /generate_pauta/)
