VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Monitoramento externo (Sentry) — opcional.
# Use somente a URL pública do Loader Script fornecida pelo projeto no Sentry.
# Exemplo: https://js.sentry-cdn.com/SEU_CLIENT_KEY_PUBLICO.min.js
# Deixe vazio para manter o monitoramento desativado.
VITE_SENTRY_LOADER_URL=

# Stripe é usado apenas no backend (Supabase Edge Functions).
# Não adicione STRIPE_SECRET_KEY, SENTRY_AUTH_TOKEN nem outras chaves privadas em variáveis VITE_*.
