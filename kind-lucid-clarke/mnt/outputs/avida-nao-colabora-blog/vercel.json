{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog/:slug", "destination": "/api/article?slug=:slug" },
    { "source": "/blog", "destination": "/api/page?route=blog" },
    { "source": "/conteudos", "destination": "/api/page?route=blog" },
    { "source": "/planos", "destination": "/api/page?route=pricing" },
    { "source": "/faq", "destination": "/api/page?route=faq" },
    { "source": "/perguntas-frequentes", "destination": "/api/page?route=faq" },
    { "source": "/sobre", "destination": "/api/page?route=about" },
    { "source": "/contato", "destination": "/api/page?route=contact" },
    { "source": "/privacidade", "destination": "/api/page?route=privacy" },
    { "source": "/termos", "destination": "/api/page?route=terms" },
    { "source": "/aviso-de-responsabilidade", "destination": "/api/page?route=responsibility" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.sentry-cdn.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://generativelanguage.googleapis.com https://api.groq.com https://www.googleapis.com https://api.resend.com https://*.ingest.sentry.io; frame-src https://js.stripe.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
